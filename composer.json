{
  "name": "checkview/checkview",
  "description": "CheckView is a fully automated solution to test your WordPress forms and detect form problems fast.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://checkview.io",
  "authors": [
    {
      "name": "CheckView",
      "homepage": "https://checkview.io"
    }
  ],
  "require": {
    "php": ">=8.0",
    "firebase/php-jwt": "^7.0",
    "ext-json": "*"
  },
  "config": {
    "vendor-dir": "includes/vendor",
    "optimize-autoloader": true
  },
  "scripts": {
    "tools":  "@composer install --working-dir=tools/phpcs",
    "lint":   "tools/phpcs/vendor/bin/phpcs",
    "format": "tools/phpcs/vendor/bin/phpcbf"
  },
  "scripts-descriptions": {
    "tools":  "Install dev-only PHPCS tooling into tools/phpcs/vendor.",
    "lint":   "Run PHPCS (requires composer tools).",
    "format": "Run PHPCBF (requires composer tools)."
  }
}
