# Directories excluded from the WordPress.org distribution build
/.wordpress-org
/.git
/.github
/.cache
/node_modules
/vendor
/scripts
/docs
# Stray local WordPress core checkout (gitignored; never part of the plugin)
/wordpress

# Linting / static analysis config
.phpcs.xml.dist
phpmd.xml

# Packaging / VCS metadata
.distignore
.gitignore
.removeable-files

# Build & tooling config
webpack.config.js
.wp-env.json

# Lockfiles / generated manifests (no runtime role). Note that Composer's
# vendor-dir is includes/vendor, which is committed and MUST ship (php-jwt is
# used at runtime) — the /vendor line above intentionally matches nothing.
composer.lock
pnpm-lock.yaml
